{
  "name": "landing",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "dev": "npm run build && wrangler dev",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --report-unused-disable-directives --max-warnings=0",
    "lint:agent": "npm run lint -- --format=agent",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "github:stats": "tsx scripts/github-stats.ts"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@floating-ui/dom": "^1.7.4",
    "@ui-sdk/core": "0.1.0-beta.17",
    "@ui-sdk/web": "0.1.0-beta.17",
    "hono": "^4.7.5",
    "html-to-image": "^1.11.13",
    "three": "^0.185.1",
    "throttle-debounce": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.1",
    "gray-matter": "^4.0.3",
    "lucide-static": "^0.445.0",
    "marked": "^14.0.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.148.0",
    "zod": "^4.0.0"
  }
}
