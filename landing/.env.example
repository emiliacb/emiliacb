# CACHE_VERSION: This variable is used for cache busting.
CACHE_VERSION=x.x.x

# KIMI_API_ENDPOINT: Moonshot's OpenAI-compatible base URL, including /v1.
# There are two valid values depending on the account's region:
#   https://api.moonshot.ai/v1 (international)
#   https://api.moonshot.cn/v1 (China)
KIMI_API_ENDPOINT=https://api.moonshot.ai/v1
# KIMI_API_KEY: secret API key for the Kimi/Moonshot account above.
KIMI_API_KEY=
# KIMI_MODEL: chat model id to use for the mascot comment endpoint.
KIMI_MODEL=kimi-k2-0711-preview
