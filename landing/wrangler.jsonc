{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emiliacb",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Custom Domains: deploying creates their DNS records and certificates, so
  // the zone needs no hand-made records. www serves the same site; every page's
  // canonical points at the apex.
  "routes": [
    { "pattern": "emiliacabral.com", "custom_domain": true },
    { "pattern": "www.emiliacabral.com", "custom_domain": true }
  ],
  // Keeps the *.workers.dev URL as a second way in, to test a deploy against.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    // Must match the language-less routes in src/worker/index.ts (the test in
    // test/site/worker-routes.test.ts checks every PAGES path is listed here).
    "run_worker_first": ["/", "/about", "/services", "/courses", "/blog", "/blog/*", "/labs/*", "/health", "/api/*"]
  },
  "observability": { "enabled": true }
}
